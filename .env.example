# Supabase PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase API & Storage
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Application Secrets
JWT_SECRET="your-secure-jwt-secret"

# Google Gemini (اختياري — توليد محتوى التقارير)
# المفتاح من https://aistudio.google.com/apikey — يوضع في .env وليس هنا
GEMINI_API_KEY=""
# الافتراضي gemini-2.5-flash-lite (الأوفر) — بدّله إلى gemini-2.5-flash لجودة أعلى
GEMINI_MODEL="gemini-2.5-flash-lite"
